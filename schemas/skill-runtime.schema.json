{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontend Performance Analysis Team Runtime",
  "type": "object",
  "required": [
    "schemaVersion",
    "skill",
    "runtime",
    "entrypoints",
    "install",
    "agentHints"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "entrypoints": {
      "type": "object"
    },
    "install": {
      "type": "object"
    },
    "agentHints": {
      "type": "object",
      "required": [
        "readOrder",
        "executionPolicy",
        "roleActivationPolicy",
        "verificationPolicy"
      ],
      "properties": {
        "readOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "executionPolicy": {
          "type": "string",
          "minLength": 1
        },
        "roleActivationPolicy": {
          "type": "string",
          "minLength": 1
        },
        "verificationPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": true
}
